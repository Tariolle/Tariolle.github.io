---
import type { WorkItem } from "../data/work";

interface Props {
  item: WorkItem;
}

const { item } = Astro.props;
const primaryLink = item.links[0];
const searchableText = [
  item.title,
  item.year,
  item.context,
  item.description,
  ...item.labels,
  ...item.details,
].join(" ").toLowerCase();
const contextParts = item.contextFirst ? [item.context, item.details[0]] : [item.details[0], item.context];
const context = contextParts.filter(Boolean).join(" · ");
---

<article
  class="work-index-row"
  data-work-item
  data-work-categories={item.categories.join(" ")}
  data-work-search-text={searchableText}
>
  <p class="work-index-year">{item.year}</p>

  <div class="work-index-main">
    {primaryLink ? (
      <a class="work-index-title-link" href={primaryLink.href} target="_blank" rel="noreferrer">
        <h2>{item.title}</h2>
      </a>
    ) : (
      <h2>{item.title}</h2>
    )}
    <p class="work-index-context">
      {context}
      {item.repo && (
        <>
          <span aria-hidden="true"> · </span>
          <span data-github-repo={item.repo} data-github-stars={item.stars} aria-live="polite">
            {item.stars?.toLocaleString("en-US")} stars
          </span>
        </>
      )}
    </p>
    {item.links.length > 0 && <div class="work-index-links" aria-label={`${item.title} links`}>
      {item.links.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
      ))}
    </div>}
  </div>

  <p class="work-index-description">{item.description}</p>

  {primaryLink && (
    <a
      class="work-index-arrow"
      href={primaryLink.href}
      target="_blank"
      rel="noreferrer"
      aria-label={`Open ${item.title}`}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 17 17 7M8 7h9v9"></path>
      </svg>
    </a>
  )}
</article>
