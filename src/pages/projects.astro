---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    title: "Geometry-Aware Joint-Embedding EEG",
    tagline: "Self-supervised learning · EEG · Riemannian geometry",
    description: "Finalist at Hack the World(s), a 24-hour hackathon on JEPAs and world models sponsored by Yann LeCun. We built a compact self-supervised EEG pipeline with SIGReg frozen-transfer baselines and Riemannian latent analysis. The manifold-aware visualizations exposed useful structure in SPD covariance representations.",
    links: [
      { label: "Code", href: "https://github.com/Tariolle/hello-worlds" },
      { label: "Deck", href: "https://github.com/Tariolle/hello-worlds/blob/main/presentation/main.pdf" },
    ],
  },
  {
    title: "DashVMC",
    tagline: "Discrete world models · Control · 30 FPS deployment",
    description: "An independent research project on real-time discrete world model control in Geometry Dash. The system combines an FSQ tokenizer, an action-conditioned transformer world model, and a lightweight actor-critic trained from behavioural cloning plus PPO in latent token rollouts.",
    links: [
      { label: "Project page", href: "https://tariolle.github.io/dash-vmc/" },
      { label: "Code", href: "https://github.com/Tariolle/dash-vmc" },
    ],
  },
  {
    title: "Rose",
    tagline: "Open source · Real-time systems · Team leadership",
    description: "A high-traffic real-time customization tool. I co-founded the project, led development, coordinated a six-person team, and designed the core Python backend, Cloudflare Workers WebSocket relay, and browser-side JavaScript integration.",
    repo: "Alban1911/Rose",
    stat: "25K+ daily active users",
    links: [{ label: "Code", href: "https://github.com/Alban1911/Rose" }],
  },
  {
    title: "VisualTorch",
    tagline: "PyTorch · Architecture visualization · MCP",
    description: "An open-source PyTorch architecture visualization library. I maintain the project and designed and implemented its MCP integration for generating neural-network architecture diagrams.",
    repo: "willyfh/visualtorch",
    links: [{ label: "Code", href: "https://github.com/willyfh/visualtorch" }],
  },
];
---

<BaseLayout
  page="projects"
  title="Projects — Florent Tariolle"
  description="Research and engineering projects by Florent Tariolle across world models, self-supervised learning, and open-source systems."
>
  <section class="page-section page-section--standalone" aria-labelledby="projects-title">
    <h1 class="sr-only" id="projects-title">Selected work</h1>
    <div class="project-list" data-section-rule>
      {projects.map((project, index) => (
        <article class="project-item" data-reveal>
          <span class="project-number">{String(index + 1).padStart(2, "0")}</span>
          <div class="project-title-wrap">
            <h2>{project.title}</h2>
            <p class="project-tagline">{project.tagline}</p>
          </div>
          <div class="project-detail">
            <p>{project.description}</p>
            {project.stat && <span class="project-stat">{project.stat}</span>}
            {project.repo && <span class="project-stat" data-github-repo={project.repo}>GitHub repository</span>}
            <div class="project-links">
              {project.links.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
