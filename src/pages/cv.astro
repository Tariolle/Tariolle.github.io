---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";

const cvPdf = "https://raw.githubusercontent.com/Tariolle/curriculum-vitae/refs/heads/master/main.pdf";
---

<BaseLayout
  page="cv"
  title="Florent Tariolle - CV"
  description="Curriculum vitae of Florent Tariolle, an AI engineering student working on deep learning research."
>
  <section class="page-section page-section--cv" aria-labelledby="cv-title">
    <h1 class="sr-only" id="cv-title">Curriculum vitae</h1>
    <div class="cv-toolbar" data-reveal>
      <p class="eyebrow">CURRICULUM VITAE</p>
      <div class="cv-actions">
        <a class="text-link" href={cvPdf} target="_blank" rel="noreferrer">Open PDF ↗</a>
        <a class="text-link" href={cvPdf}>Download PDF ↓</a>
      </div>
    </div>
    <div class="cv-frame-wrap" data-reveal>
      <a
        class="cv-preview-link"
        href={cvPdf}
        target="_blank"
        rel="noreferrer"
        aria-label="Open Florent Tariolle's curriculum vitae as a PDF"
      >
        <canvas
          class="cv-preview"
          data-cv-preview
          data-pdf-url={cvPdf}
          aria-label="Preview of Florent Tariolle's latest curriculum vitae"
        ></canvas>
        <span class="cv-preview-status" data-cv-preview-status>Loading latest CV…</span>
      </a>
    </div>
  </section>
  <Footer />
</BaseLayout>

<script>
  import { getDocument, GlobalWorkerOptions } from "pdfjs-dist";
  import pdfWorker from "pdfjs-dist/build/pdf.worker.min.mjs?url";

  GlobalWorkerOptions.workerSrc = pdfWorker;

  const canvas = document.querySelector<HTMLCanvasElement>("[data-cv-preview]");
  const status = document.querySelector<HTMLElement>("[data-cv-preview-status]");

  if (canvas && status) {
    const pdfUrl = canvas.dataset.pdfUrl;

    if (!pdfUrl) {
      status.textContent = "Preview unavailable — open the latest PDF";
    } else {
      try {
        const pdf = await getDocument({ url: pdfUrl }).promise;
        const page = await pdf.getPage(1);
        const naturalViewport = page.getViewport({ scale: 1 });
        const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        const scale = (canvas.clientWidth * pixelRatio) / naturalViewport.width;
        const viewport = page.getViewport({ scale });

        canvas.width = Math.floor(viewport.width);
        canvas.height = Math.floor(viewport.height);
        await page.render({ canvas, viewport }).promise;
        status.hidden = true;
      } catch {
        status.textContent = "Preview unavailable — open the latest PDF";
      }
    }
  }
</script>
