---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";

const cvPdf = "/documents/florent-tariolle-cv.pdf";
---

<BaseLayout
  page="cv"
  title="Florent Tariolle - CV"
  description="Curriculum vitae of Florent Tariolle, an AI engineering student working on deep learning research."
>
  <section class="page-section page-section--cv" aria-labelledby="cv-title">
    <h1 class="sr-only" id="cv-title">Curriculum vitae</h1>
    <div class="cv-toolbar" data-reveal>
      <p class="eyebrow">Current document</p>
      <div class="cv-actions">
        <a class="text-link" href={cvPdf} target="_blank" rel="noreferrer">Open PDF ↗</a>
        <a class="text-link" href={cvPdf} download="Florent_Tariolle_CV.pdf">Download PDF ↓</a>
      </div>
    </div>
    <div class="cv-frame-wrap" data-reveal>
      <a
        class="cv-preview-link"
        href={cvPdf}
        target="_blank"
        rel="noreferrer"
        aria-label="Open Florent Tariolle's curriculum vitae as a PDF"
      >
        <img
          class="cv-preview"
          src="/images/cv-preview.png"
          width="1654"
          height="2339"
          alt="Preview of Florent Tariolle's curriculum vitae"
          decoding="async"
        />
      </a>
    </div>
  </section>
  <Footer />
</BaseLayout>
