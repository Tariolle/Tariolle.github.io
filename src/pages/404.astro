    <span class="page-hero-index">404</span>
    <div class="not-found-content">
      <h1>Outside the field.</h1>
      <p>The page you requested does not exist.</p>
      <a class="text-link" href="/">Return home →</a>
    </div>
  </header>
</BaseLayout>
