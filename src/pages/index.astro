---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import LatentField from "../components/LatentField.astro";
import WorkSection from "../components/WorkSection.astro";
---

<BaseLayout page="home">
  <section class="hero" aria-labelledby="hero-title">
    <LatentField />
    <div class="hero-copy">
      <div class="hero-title-mask">
        <h1 class="hero-title" id="hero-title" data-hero-title>Florent Tariolle</h1>
      </div>
      <p class="hero-statement" data-hero-detail>
        I build deep neural networks that think, predict and act.
      </p>
      <p class="hero-topics" data-hero-detail>
        World models · Self-supervised learning · Reinforcement learning
      </p>
      <nav class="hero-links" aria-label="Contact and profiles" data-hero-detail>
        <a href="mailto:florent.tariolle@gmail.com">Email</a>
        <a href="https://github.com/Tariolle" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://scholar.google.com/citations?user=z5QWV8kAAAAJ" target="_blank" rel="noreferrer">Scholar</a>
        <a href="https://www.linkedin.com/in/florent-tariolle/" target="_blank" rel="noreferrer">LinkedIn</a>
      </nav>
    </div>
  </section>

  <section class="home-section" id="home-section" aria-labelledby="about-title">
    <div class="about-grid">
      <div class="about-copy" data-reveal>
        <h2 id="about-title">Research that crosses representation and action.</h2>
        <div class="about-copy-body">
          <p>
            I am an engineering student in Computer Science and Artificial Intelligence at{" "}
            <a href="https://www.insa-rouen.fr/" target="_blank" rel="noreferrer">INSA Rouen Normandy</a>{" "}
            and an incoming Master's student in Machine Learning for Artificial Intelligence at the{" "}
            <a href="https://mastersd.univ-rouen.fr/mlai.php" target="_blank" rel="noreferrer">University of Rouen Normandy</a>.
          </p>
          <p>
            At{" "}<a href="https://www.interdigital.com/video-lab/video-codec-research" target="_blank" rel="noreferrer">InterDigital</a>,
            I work on deep learning for next-generation video compression. At{" "}
            <a href="https://www.enedis.fr/" target="_blank" rel="noreferrer">Enedis</a>, I work on generative modeling and large-scale pipelines for high-frequency electricity-grid time series.
          </p>
        </div>
        <p class="availability">Seeking a six-month research internship starting in April 2027</p>
      </div>
    </div>
  </section>

  <WorkSection />

  <Footer />
</BaseLayout>
